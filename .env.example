OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_OPTIONS=gpt-4o-mini,gpt-4o,deepseek-chat
OPENAI_TIMEOUT_SECONDS=60
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

DATABASE_URL=sqlite:///./data/paper2repo.db
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
UPLOAD_MAX_MB=50
PDF_MAX_PAGES=300
PDF_OCR_ENABLED=true
PDF_OCR_MIN_CHARS=80
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=150
PDF_EXTRACT_TABLES=true
PDF_EXTRACT_FORMULAS=true
RUN_STALE_AFTER_MINUTES=60
ANALYSIS_MAX_WORKERS=3
ANALYSIS_MAX_QUEUED_JOBS=20
ANALYSIS_JOB_LEASE_SECONDS=3600
ANALYSIS_JOB_MAX_ATTEMPTS=2
ANALYSIS_RECOVERY_INTERVAL_SECONDS=30
